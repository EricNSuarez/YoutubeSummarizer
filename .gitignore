# Standard Python .gitignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
env/

# IDE (PyCharm)
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Logs and databases
*.log
logs/
*.sqlite

# Local development
tmp/
temp/

# Coverage
.coverage
htmlcov/

# Secrets
secrets.yml
*.key
*.cert

# Project-specific (optional)
.DS_Store
*.swp
*.swo
